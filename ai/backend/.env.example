# Copy file này thành .env rồi điền giá trị thật. KHÔNG commit file .env.
NODE_ENV=development
PORT=5000

# Các origin của frontend được phép gọi API (phân tách bằng dấu phẩy)
CORS_ORIGIN=http://localhost:3000

# MongoDB
MONGO_URI=mongodb://localhost:27017/
MONGO_DB_NAME=projtt

# Chuỗi bí mật ngẫu nhiên, dài (vd: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=change_me

# Bot tư vấn ESH (RAG)
GEMINI_API_KEY=
GEMINI_MODEL=gemma-3n-e2b-it
HF_TOKEN=
CHROMA_API_KEY=
CHROMA_TENANT=
CHROMA_DATABASE=
# Thư mục chứa các file .md của knowledge base
CHUNKS_DIR=./knowledgeBase/chunks

# Cloudinary (upload ảnh)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
